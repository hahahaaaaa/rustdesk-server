#!/command/with-contenv sh
cd /data || exit 1

export API_BIND="${API_BIND:-0.0.0.0}"
export API_PORT="${API_PORT:-21114}"
export API_DB_PATH="${API_DB_PATH:-/data/api.sqlite3}"
export API_CONSOLE_DIR="${API_CONSOLE_DIR:-/usr/share/rustdesk-console}"
export API_RECORDINGS_DIR="${API_RECORDINGS_DIR:-/data/recordings}"
export API_HBBS_DB_PATH="${API_HBBS_DB_PATH:-/data/db_v2.sqlite3}"

mkdir -p "$API_RECORDINGS_DIR"

exec /usr/bin/rustdesk-api
